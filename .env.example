# EmailJS configuration (https://www.emailjs.com/)
# 1. Create a free EmailJS account
# 2. Add your Gmail as an email service → get the Service ID
# 3. Create an email template → get the Template ID
# 4. Copy your Public Key from Account → General
VITE_EMAILJS_SERVICE_ID=service_portfolio
VITE_EMAILJS_TEMPLATE_ID=template_contact
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
